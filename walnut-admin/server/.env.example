# Copy to .env (gitignored) and fill in. Local dev works with every value
# commented out: secrets are generated into .data/dev-secrets.json, MongoDB is
# embedded, and emails are printed to the console.

# Resend API key (https://resend.com/api-keys) — invites + password resets
RESEND_API_KEY=
# Sender. Must be a verified Resend domain/sender, e.g.
# "Walnut Admin <no-reply@walnutmedical.in>"
MAIL_FROM=Walnut Admin <onboarding@resend.dev>

# Public URL of the admin panel (invite/reset links are built from it)
APP_URL=http://localhost:5174

# Comma-separated allow-list of staff email domains
ALLOWED_EMAIL_DOMAINS=walnutmedical.in

# MongoDB connection string (local dev: leave empty for embedded MongoDB;
# deploy: Atlas M0 connection string)
MONGODB_URI=

# Vercel deploy hook for the website rebuild after publishing content
VERCEL_DEPLOY_HOOK_URL=

# Extra CORS origins for the public content API
PUBLIC_CORS_ORIGINS=https://walnutmedical.in,https://www.walnutmedical.in,http://localhost:3000,http://localhost:5173

# Bootstrap admin (used by `npm run create-admin`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
